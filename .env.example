# Database (SQLite local or Turso/libsql URL)
DATABASE_URL="file:./prisma/dev.db"
# TURSO_AUTH_TOKEN=   # required for remote libsql URLs

# Auth.js — required in production (min 32 chars)
# Generate: openssl rand -base64 32
AUTH_SECRET=
# Optional locally (trustHost is on). In production set to the exact public origin.
# Must match the URL users open (localhost vs 127.0.0.1 matters).
# AUTH_URL=https://your-domain.com

# First-time seed only — min 8 characters (not stored in repo)
ADMIN_INITIAL_PASSWORD=
ADMIN_PHONE=09124496001

# Secret path for the management panel (also update middleware matcher if changed)
NEXT_PUBLIC_ADMIN_PATH=/yaqoot-cms

# Public site origin (canonical / Open Graph / sitemap)
NEXT_PUBLIC_SITE_URL=https://yaghootcarpet.com

# Image storage: local disk (VPS)
STORAGE_DRIVER=local

# Absolute folder for uploaded images on the VPS (Nginx serves /uploads from here)
# UPLOADS_DIR=/srv/yaghoot/data/uploads

# Dev only — enables mock payment button (never set in production)
# ALLOW_MOCK_PAYMENT=true
